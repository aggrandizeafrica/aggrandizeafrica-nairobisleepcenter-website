# Apache / cPanel hosting (ignored by Vercel)
Options -Indexes
ErrorDocument 404 /404.html
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^nairobisleepcenter\.com$ [NC]
RewriteRule ^ https://www.nairobisleepcenter.com%{REQUEST_URI} [L,R=301]
RewriteRule ^book-appointment-2/?$ /book-appointment/ [L,R=301]
RewriteRule ^sleep-studypolysomnography/?$ /sleep-study-polysomnography/ [L,R=301]
RewriteRule ^services/?$ /conditions/ [L,R=301]
RewriteRule ^equipments/?$ /cpap-equipment/ [L,R=301]
RewriteRule ^equipments/.*/?$ /cpap-equipment/ [L,R=301]
RewriteRule ^gallery/?$ /about-us/ [L,R=301]
RewriteRule ^blog-classic/?$ / [L,R=301]
RewriteRule ^author/admin/?$ / [L,R=301]
RewriteRule ^privacy/?$ /privacy-policy/ [L,R=301]
RewriteRule ^wp-sitemap\.xml/?$ /sitemap.xml [L,R=301]
RewriteRule ^sitemap_index\.xml/?$ /sitemap.xml [L,R=301]
RewriteRule ^readme\.html/?$ / [L,R=301]

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(woff2|png|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json text/plain
</IfModule>
